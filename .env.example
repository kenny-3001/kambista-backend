# Server
NODE_ENV=development
PORT=3000

# Database (docker-compose exposes MongoDB on localhost:27017)
MONGO_URI=mongodb://localhost:27017/kambista

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# JWT (secret must be at least 32 characters; generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
# The example value works locally but is rejected when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
# Short-lived access token; the session is renewed with the refresh token
JWT_EXPIRES_IN=15m
# Days a refresh token lasts; each refresh issues a new one
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Brute-force protection: failed logins allowed per email and IP, and the
# window (in minutes) after which the count starts again
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPTS_WINDOW_MINUTES=15

# SUNAT exchange rate provider (fetched and stored every 30 seconds)
EXCHANGE_RATE_API_URL=https://api.apis.net.pe/v1/tipo-cambio-sunat
EXCHANGE_RATE_REFRESH_INTERVAL_MS=30000
EXCHANGE_RATE_TIMEOUT_MS=5000

# Admin user created or promoted by `npm run seed:admin`
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
